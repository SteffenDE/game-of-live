<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · Game Of Live(View)">
      <%= assigns[:page_title] || "GameOfLive" %>
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <link
      phx-track-static
      rel="icon"
      type="image/webp"
      sizes="120x120"
      href={~p"/images/favicon-120x120.webp"}
    />
    <link
      phx-track-static
      rel="icon"
      type="image/png"
      sizes="120x120"
      href={~p"/images/favicon-120x120.png"}
    />
    <link
      phx-track-static
      rel="apple-touch-icon"
      sizes="180x180"
      href={~p"/images/apple-touch-icon.png"}
    />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/app.js"}
    >
    </script>
  </head>
  <body>
    <%= @inner_content %>
  </body>
</html>
